{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "college-reality",
          "appId": "1:244446156099:android:0471c18323c4bdf5bf0bf6",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "college-reality",
          "configurations": {
            "android": "1:244446156099:android:0471c18323c4bdf5bf0bf6",
            "ios": "1:244446156099:ios:34c193b0e798f5f0bf0bf6",
            "macos": "1:244446156099:ios:34c193b0e798f5f0bf0bf6",
            "web": "1:244446156099:web:bb6c7e0dabe7a5efbf0bf6",
            "windows": "1:244446156099:web:e8ebbd6d74d629bdbf0bf6"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "predeploy": [
      "python tools/check_hosting_placeholders.py"
    ],
    "public": "hosting/public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.@(css|svg|png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
