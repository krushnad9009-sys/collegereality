# Cloud Functions — local/deploy environment template.
# Copy to `.env.<projectId>` (e.g. `.env.college-reality`) and fill in.
# This file holds ONLY non-secret deploy-time params. It is safe to commit.
#
# Real secrets are NEVER put in any .env file. They live in Google Secret
# Manager and are attached per-function at deploy time. Set them with:
#
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
#   firebase functions:secrets:set AGORA_APP_ID
#   firebase functions:secrets:set AGORA_APP_CERTIFICATE
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set RESEND_API_KEY
#
# See functions/README.md ("Required secrets") for where each value comes from.

# ---------------------------------------------------------------------------
# Non-secret deploy params (safe to keep here)
# ---------------------------------------------------------------------------

# Verified sender for the email-OTP messages. Must be an address on a domain
# you have verified in Resend. `onboarding@resend.dev` only delivers to your
# own Resend account and is for local testing only.
RESEND_FROM=College Reality <onboarding@resend.dev>
