rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'super_admin';
    }

    function isModerator() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'moderator';
    }

    function isStaff() {
      return isAdmin() || isModerator();
    }

    function isCollegeOfficial(collegeId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/college_accounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/college_accounts/$(request.auth.uid)).data.collegeId == collegeId &&
        get(/databases/$(database)/documents/college_accounts/$(request.auth.uid)).data.isVerified == true;
    }

    function isVerifiedFaculty() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationBadge == 'verified_faculty';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isAggregateOnlyUpdate() {
      return affectedKeys().hasOnly([
        'aggregatedRatings', 'reviewCount', 'ratingDistribution',
        'reviewAggregation', 'crScore', 'crScoreCategories', 'crScoreUpdatedAt',
        'wouldChooseAgainYes', 'wouldChooseAgainTotal', 'updatedAt'
      ]);
    }

    // Verified students may bump college aggregates by exactly one review (±1).
    function isBoundedCollegeAggregateUpdate() {
      let oldCount = resource.data.get('reviewCount', 0);
      let newCount = request.resource.data.get('reviewCount', 0);
      return isVerifiedStudent() &&
        isAggregateOnlyUpdate() &&
        oldCount is number &&
        newCount is number &&
        newCount >= 0 &&
        newCount < 1000000 &&
        (newCount == oldCount + 1 || newCount == oldCount - 1);
    }

    function isGuideStatsOnlyUpdate() {
      return affectedKeys().hasOnly(['guideStats', 'updatedAt']);
    }

    function guideStatsMap(data) {
      return data.get('guideStats', {});
    }

    function isGuideStatsLastActiveUpdate() {
      let oldStats = guideStatsMap(resource.data);
      let newStats = guideStatsMap(request.resource.data);
      return isGuideStatsOnlyUpdate() &&
        newStats.get('totalRatings', 0) == oldStats.get('totalRatings', 0) &&
        newStats.get('totalCalls', 0) == oldStats.get('totalCalls', 0) &&
        newStats.get('totalChats', 0) == oldStats.get('totalChats', 0) &&
        newStats.get('overallRating', 0) == oldStats.get('overallRating', 0) &&
        newStats.get('badgeTier', 'none') == oldStats.get('badgeTier', 'none') &&
        newStats.get('helpfulPercent', 0) == oldStats.get('helpfulPercent', 0) &&
        newStats.get('respectfulPercent', 0) == oldStats.get('respectfulPercent', 0) &&
        newStats.get('recommendPercent', 0) == oldStats.get('recommendPercent', 0);
    }

    function isGuideStatsRatingUpdate() {
      let oldStats = guideStatsMap(resource.data);
      let newStats = guideStatsMap(request.resource.data);
      return isGuideStatsOnlyUpdate() &&
        newStats.get('totalRatings', 0) == oldStats.get('totalRatings', 0) + 1 &&
        newStats.get('overallRating', 0) >= 0 &&
        newStats.get('overallRating', 0) <= 5 &&
        newStats.get('totalCalls', 0) >= oldStats.get('totalCalls', 0) &&
        newStats.get('totalCalls', 0) <= oldStats.get('totalCalls', 0) + 1 &&
        newStats.get('totalChats', 0) >= oldStats.get('totalChats', 0) &&
        newStats.get('totalChats', 0) <= oldStats.get('totalChats', 0) + 1 &&
        newStats.get('badgeTier', 'none') in ['none', 'bronze', 'silver', 'gold'] &&
        newStats.get('helpfulPercent', 0) >= 0 &&
        newStats.get('helpfulPercent', 0) <= 100 &&
        newStats.get('respectfulPercent', 0) >= 0 &&
        newStats.get('respectfulPercent', 0) <= 100 &&
        newStats.get('recommendPercent', 0) >= 0 &&
        newStats.get('recommendPercent', 0) <= 100;
    }

    function ownerAllowedVerificationStatusChange() {
      let oldStatus = resource.data.get('verificationStatus', 'incomplete');
      let newStatus = request.resource.data.get('verificationStatus', 'incomplete');
      return oldStatus == newStatus ||
        (
          newStatus in ['incomplete', 'pending_review', 'flagged'] &&
          oldStatus in [
            'incomplete', 'rejected', 'resubmission_requested',
            'pending_review', 'flagged'
          ] &&
          newStatus != 'approved'
        );
    }

    // Owners may update profile fields but cannot self-elevate roles/verification.
    function ownerCannotElevatePrivileges() {
      return request.resource.data.userType == resource.data.userType &&
        request.resource.data.get('verificationBadge', 'none') ==
          resource.data.get('verificationBadge', 'none') &&
        request.resource.data.get('isVerified', false) ==
          resource.data.get('isVerified', false) &&
        ownerAllowedVerificationStatusChange() &&
        (
          resource.data.get('verificationStatus', '') != 'approved' ||
          request.resource.data.get('collegeId', null) ==
            resource.data.get('collegeId', null)
        ) &&
        // Guide reputation must use dedicated lastActive / rating helpers.
        request.resource.data.get('guideStats', {}) ==
          resource.data.get('guideStats', {});
    }

    function isSafeUserCreate(userId) {
      let stats = request.resource.data.get('guideStats', {});
      return isOwner(userId) &&
        request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
        request.resource.data.userType == 'student' &&
        request.resource.data.get('verificationBadge', 'none') == 'none' &&
        request.resource.data.get('verificationStatus', 'incomplete') in
          ['incomplete', 'none'] &&
        request.resource.data.get('isVerified', false) == false &&
        stats.get('totalRatings', 0) == 0 &&
        stats.get('overallRating', 0) == 0 &&
        stats.get('badgeTier', 'none') == 'none';
    }

    function canReadUserProfile(userId) {
      // `users` holds email/phone, so only the owner or staff may read the
      // full document. Any other viewer (same-college, guide directory,
      // public-profile lookups) must read the PII-free public_profiles
      // mirror instead — see match /public_profiles/{userId} below.
      return isOwner(userId) || isStaff();
    }

    function isVerifiedStudent() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() &&
        user.verificationStatus == 'approved' &&
        (user.verificationBadge == 'verified_student' ||
         user.verificationBadge == 'verified_alumni');
    }

    function isHelpfulCountOnlyUpdate(reviewId) {
      return affectedKeys().hasOnly(['helpfulCount', 'updatedAt']) &&
        request.resource.data.helpfulCount ==
          resource.data.get('helpfulCount', 0) + 1 &&
        !exists(/databases/$(database)/documents/reviews/$(reviewId)/helpful/$(request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/reviews/$(reviewId)/helpful/$(request.auth.uid));
    }

    function isOwnerReviewContentUpdate() {
      return resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.get('helpfulCount', 0) ==
          resource.data.get('helpfulCount', 0) &&
        request.resource.data.get('isVerifiedStudent', false) ==
          resource.data.get('isVerifiedStudent', false);
    }

    function isVerifiedStudentOfCollege(collegeId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isVerifiedStudent() && user.collegeId == collegeId;
    }

    function isQuestionAuthor(questionId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/college_questions/$(questionId)).data.authorId
          == request.auth.uid;
    }

    function isAnswerCountUpdate() {
      let oldCount = resource.data.get('answerCount', 0);
      let newCount = request.resource.data.get('answerCount', 0);
      return affectedKeys().hasOnly(['answerCount', 'updatedAt']) &&
        oldCount is number &&
        newCount is number &&
        (newCount == oldCount + 1 || newCount == oldCount - 1) &&
        newCount >= 0;
    }

    function isTopAnswerScoreUpdate() {
      return affectedKeys().hasOnly(['topAnswerScore', 'updatedAt']);
    }

    function isMostHelpfulQuestionUpdate() {
      return affectedKeys().hasOnly([
        'mostHelpfulAnswerId', 'mostHelpfulScore', 'updatedAt'
      ]);
    }

    function isAcceptedAnswerQuestionUpdate() {
      return affectedKeys().hasOnly(['acceptedAnswerId', 'updatedAt']);
    }

    function isQuestionAuthorContentUpdate() {
      return resource.data.authorId == request.auth.uid &&
        !affectedKeys().hasAny([
          'authorId', 'reportCount', 'mostHelpfulAnswerId', 'mostHelpfulScore',
          'acceptedAnswerId', 'answerCount', 'topAnswerScore', 'status',
          'moderationFlag'
        ]);
    }

    function isAnswerReplyCountUpdate() {
      let oldCount = resource.data.get('replyCount', 0);
      let newCount = request.resource.data.get('replyCount', 0);
      return affectedKeys().hasOnly(['replyCount', 'updatedAt']) &&
        oldCount is number &&
        newCount is number &&
        newCount == oldCount + 1;
    }

    function isAcceptedAnswerUpdate() {
      return affectedKeys().hasOnly(['isAccepted', 'updatedAt']);
    }

    function isAnswerVoteCountUpdate(questionId, answerId) {
      let oldUp = resource.data.get('upvoteCount', 0);
      let newUp = request.resource.data.get('upvoteCount', 0);
      let oldDown = resource.data.get('downvoteCount', 0);
      let newDown = request.resource.data.get('downvoteCount', 0);
      let votePath = /databases/$(database)/documents/college_questions/$(questionId)/answers/$(answerId)/votes/$(request.auth.uid);
      return affectedKeys().hasOnly([
          'upvoteCount', 'downvoteCount', 'score', 'updatedAt'
        ]) &&
        oldUp is number && newUp is number &&
        oldDown is number && newDown is number &&
        newUp >= 0 && newDown >= 0 &&
        newUp < 1000000 && newDown < 1000000 &&
        newUp - oldUp >= -1 && newUp - oldUp <= 1 &&
        newDown - oldDown >= -1 && newDown - oldDown <= 1 &&
        (
          exists(votePath) != existsAfter(votePath) ||
          (
            exists(votePath) &&
            existsAfter(votePath) &&
            get(votePath).data.vote != getAfter(votePath).data.vote
          )
        );
    }

    function isMostHelpfulAnswerUpdate() {
      return affectedKeys().hasOnly(['isMostHelpful', 'updatedAt']);
    }

    function isMessageReadByUpdate() {
      return affectedKeys().hasOnly(['readBy']) ||
        affectedKeys().hasOnly(['readBy', 'updatedAt']);
    }

    function isMessageLikeUpdate() {
      return affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
        request.resource.data.get('likeCount', 0) ==
          resource.data.get('likeCount', 0) + 1 &&
        request.auth.uid in request.resource.data.get('likedBy', []);
    }

    function isContentReportIncrementUpdate() {
      let oldCount = resource.data.get('reportCount', 0);
      let newCount = request.resource.data.get('reportCount', 0);
      return oldCount is number &&
        newCount is number &&
        newCount == oldCount + 1 &&
        (
          (
            affectedKeys().hasOnly(['reportCount', 'updatedAt']) &&
            request.resource.data.get('status', resource.data.get('status', '')) ==
              resource.data.get('status', '') &&
            request.resource.data.get('moderationFlag', null) ==
              resource.data.get('moderationFlag', null)
          ) ||
          (
            newCount >= 3 &&
            affectedKeys().hasOnly([
              'reportCount', 'status', 'moderationFlag', 'updatedAt'
            ]) &&
            request.resource.data.status == 'hidden' &&
            request.resource.data.moderationFlag == 'reported'
          )
        );
    }

    function isStudentPostSocialUpdate() {
      return affectedKeys().hasOnly([
        'commentCount', 'pollOptions', 'likeCount', 'likedBy', 'updatedAt'
      ]);
    }

    function isConversationParticipantUpdate() {
      return canAccessConversation(resource.data) &&
        affectedKeys().hasOnly([
          'typingUsers', 'lastMessageText', 'lastMessageSenderId',
          'lastMessageAt', 'updatedAt', 'replyCount', 'readReceipts'
        ]);
    }

    function isVerifiedCompanyUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/company_accounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/company_accounts/$(request.auth.uid)).data.isVerified == true;
    }

    function companyAccountCompanyId() {
      return get(/databases/$(database)/documents/company_accounts/$(request.auth.uid)).data.companyId;
    }

    function isCallParticipant(sessionId) {
      let session = get(/databases/$(database)/documents/call_sessions/$(sessionId)).data;
      return isAuthenticated() &&
        (session.callerId == request.auth.uid || session.calleeId == request.auth.uid);
    }

    function canAccessConversation(data) {
      return isAuthenticated() && (
        data.type != 'private' ||
        request.auth.uid in data.get('participantIds', [])
      );
    }

    function canAccessConversationById(conversationId) {
      return exists(/databases/$(database)/documents/community_conversations/$(conversationId)) &&
        canAccessConversation(
          get(/databases/$(database)/documents/community_conversations/$(conversationId)).data
        );
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && canReadUserProfile(userId);
      allow create: if isSafeUserCreate(userId);
      allow update: if exists(/databases/$(database)/documents/users/$(userId)) && (
        isAdmin() ||
        (isOwner(userId) && isGuideStatsLastActiveUpdate()) ||
        (isAuthenticated() &&
          request.auth.uid != userId &&
          isGuideStatsRatingUpdate()) ||
        (isOwner(userId) && ownerCannotElevatePrivileges())
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // PII-free mirror of `users` (no email/phone) read by any authenticated
    // user for guide directory / connectable-students / call setup. Written
    // by the owner or admin, or by a rater updating someone else's
    // guideStats mirror after a call/chat rating (same shape-validated
    // carve-out as the `users` doc below) — and never allowed to carry
    // email/phone even if application code has a bug.
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if (
        isOwner(userId) ||
        isAdmin() ||
        (isAuthenticated() &&
          request.auth.uid != userId &&
          isGuideStatsRatingUpdate())
      ) && !request.resource.data.keys().hasAny(['email', 'phone']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /display_names/{nameKey} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
    }

    match /colleges/{collegeId} {
      // Public college directory (home/search/browse are guest-accessible).
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isBoundedCollegeAggregateUpdate();
      allow delete: if isAdmin();
    }

    match /_meta/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isVerifiedStudent() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isVerifiedStudent == true;
      allow update: if isAdmin() ||
        (isAuthenticated() && isOwnerReviewContentUpdate()) ||
        (isAuthenticated() && isHelpfulCountOnlyUpdate(reviewId));
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);

      match /helpful/{voterId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == voterId;
      }
    }

    match /review_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /call_sessions/{sessionId} {
      allow read: if isAuthenticated() &&
        (resource.data.callerId == request.auth.uid ||
         resource.data.calleeId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.callerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.callerId == request.auth.uid ||
         resource.data.calleeId == request.auth.uid);
    }

    match /interaction_ratings/{ratingId} {
      allow read: if isAuthenticated() &&
        (resource.data.raterId == request.auth.uid ||
         resource.data.rateeId == request.auth.uid ||
         isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.raterId == request.auth.uid;
    }

    match /user_blocks/{blockId} {
      allow read: if isAuthenticated() &&
        resource.data.blockerId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.blockerId == request.auth.uid;
    }

    match /user_reports/{reportId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /verification_requests/{requestId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /verification_document_hashes/{hashId} {
      allow read: if isStaff() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
    }

    match /placement_submissions/{submissionId} {
      allow read: if isAuthenticated() &&
        (isAdmin() ||
         resource.data.userId == request.auth.uid ||
         resource.data.status == 'approved');
      allow create: if isVerifiedStudent() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isVerifiedStudent == true &&
        request.resource.data.status == 'pending_review';
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /private/{docId} {
        allow read: if isAdmin() ||
          (isAuthenticated() &&
           get(/databases/$(database)/documents/placement_submissions/$(submissionId)).data.userId == request.auth.uid);
        allow create: if isAuthenticated() &&
          get(/databases/$(database)/documents/placement_submissions/$(submissionId)).data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /community_conversations/{conversationId} {
      allow read: if canAccessConversation(resource.data);
      allow create: if isAuthenticated() && (
        request.resource.data.type != 'private' ||
        request.auth.uid in request.resource.data.get('participantIds', [])
      );
      allow update: if isAdmin() || isConversationParticipantUpdate();
      allow delete: if isAdmin();
    }

    match /community_messages/{messageId} {
      allow read: if isAuthenticated() &&
        canAccessConversationById(resource.data.conversationId);
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        canAccessConversationById(request.resource.data.conversationId);
      allow update: if isAdmin() ||
        (
          isAuthenticated() &&
          canAccessConversationById(resource.data.conversationId) &&
          (
            (
              resource.data.senderId == request.auth.uid &&
              !affectedKeys().hasAny([
                'senderId', 'likeCount', 'likedBy', 'reportCount',
                'status', 'moderationFlag'
              ])
            ) ||
            isMessageReadByUpdate() ||
            isMessageLikeUpdate() ||
            isContentReportIncrementUpdate()
          )
        );
      allow delete: if isAdmin();
    }

    match /community_reports/{reportId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /college_questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() ||
        (isAuthenticated() && isQuestionAuthorContentUpdate()) ||
        (isAuthenticated() && isAnswerCountUpdate()) ||
        (isAuthenticated() && isTopAnswerScoreUpdate()) ||
        (isQuestionAuthor(questionId) && isMostHelpfulQuestionUpdate()) ||
        (isQuestionAuthor(questionId) && isAcceptedAnswerQuestionUpdate()) ||
        (isAuthenticated() && isContentReportIncrementUpdate());
      allow delete: if isAdmin();

      match /answers/{answerId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          isVerifiedStudentOfCollege(
            get(/databases/$(database)/documents/college_questions/$(questionId)).data.collegeId
          ) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.isVerifiedStudent == true;
        allow update: if isAdmin() ||
          (
            isAuthenticated() &&
            resource.data.authorId == request.auth.uid &&
            !affectedKeys().hasAny([
              'authorId', 'upvoteCount', 'downvoteCount', 'score',
              'isMostHelpful', 'isAccepted', 'replyCount', 'reportCount',
              'status', 'moderationFlag'
            ])
          ) ||
          (isAuthenticated() && isAnswerVoteCountUpdate(questionId, answerId)) ||
          (isQuestionAuthor(questionId) && isMostHelpfulAnswerUpdate()) ||
          (isQuestionAuthor(questionId) && isAcceptedAnswerUpdate()) ||
          (isAuthenticated() && isAnswerReplyCountUpdate()) ||
          (isAuthenticated() && isContentReportIncrementUpdate());
        allow delete: if isAdmin();

        match /votes/{voterId} {
          allow read: if isAuthenticated();
          allow create, update: if isAuthenticated() && request.auth.uid == voterId;
          allow delete: if isAuthenticated() && request.auth.uid == voterId;
        }

        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() &&
            isVerifiedStudentOfCollege(
              get(/databases/$(database)/documents/college_questions/$(questionId)).data.collegeId
            ) &&
            request.resource.data.authorId == request.auth.uid;
          allow update, delete: if isAdmin() ||
            (isAuthenticated() && resource.data.authorId == request.auth.uid);
        }
      }
    }

    match /question_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /answer_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /scholarships/{scholarshipId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /entrance_exams/{examId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /cutoff_records/{cutoffId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /admission_predictions/{predictionId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /saved_scholarships/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /internships/{internshipId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() ||
        (isVerifiedCompanyUser() &&
          request.resource.data.companyId == companyAccountCompanyId());
      allow update, delete: if isAdmin() ||
        (isVerifiedCompanyUser() &&
          resource.data.companyId == companyAccountCompanyId());
    }

    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() ||
        (isVerifiedCompanyUser() &&
          request.resource.data.companyId == companyAccountCompanyId());
      allow update, delete: if isAdmin() ||
        (isVerifiedCompanyUser() &&
          resource.data.companyId == companyAccountCompanyId());
    }

    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /company_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isVerifiedStudent() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isVerifiedStudent == true;
      allow update, delete: if isAdmin();
    }

    match /alumni_profiles/{alumniId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /saved_internships/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /saved_jobs/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /alumni_follows/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.followerId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.followerId == request.auth.uid;
    }

    match /internship_applications/{applicationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin() ||
          (isVerifiedCompanyUser() &&
            resource.data.companyId == companyAccountCompanyId()));
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() ||
        (isVerifiedCompanyUser() &&
          resource.data.companyId == companyAccountCompanyId() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /job_applications/{applicationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin() ||
          (isVerifiedCompanyUser() &&
            resource.data.companyId == companyAccountCompanyId()));
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() ||
        (isVerifiedCompanyUser() &&
          resource.data.companyId == companyAccountCompanyId() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /student_resumes/{userId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /company_accounts/{userId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /campus_events/{eventId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /student_clubs/{clubId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /competitions/{competitionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /student_communities/{communityId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /student_community_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isVerifiedStudent() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.isVerifiedStudent == true;
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid) ||
        (isAuthenticated() && isStudentPostSocialUpdate()) ||
        (isAuthenticated() && isContentReportIncrementUpdate());
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          isVerifiedStudent() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.isVerifiedStudent == true;
        allow update: if isAdmin() ||
          (isAuthenticated() && resource.data.authorId == request.auth.uid);
        allow delete: if isAdmin();
      }
    }

    match /event_registrations/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /saved_events/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /club_join_requests/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /student_community_post_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /student_community_comment_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /student_community_poll_votes/{voteId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
    }

    match /user_notifications/{notificationId} {
      // Notifications are authored by whoever triggers them (commenter,
      // rater, connection request, ...), not the recipient — there is no
      // Cloud Functions layer to proxy these as a trusted backend, so
      // cross-user creates must be allowed here (shape-validated below).
      // `resource == null` covers reads of a not-yet-created doc (the
      // dedupe check that runs before every insert), which would
      // otherwise error out and deny even the eventual owner.
      allow read: if isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.userId is string &&
          request.resource.data.userId != '' &&
          request.resource.data.type is string &&
          request.resource.data.title is string &&
          request.resource.data.category is string &&
          request.resource.data.isRead == false &&
          request.resource.data.keys().hasAll([
            'userId', 'type', 'title', 'category', 'isRead', 'createdAt'
          ])
        )
      );
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead', 'updatedAt']);
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /notification_preferences/{userId} {
      // Read must be cross-user: notifyUser() checks the *recipient's*
      // alert toggles from the actor's auth context before writing a
      // notification. These are boolean toggles only, no PII.
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
    }

    match /admission_calendar_events/{eventId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /saved_entrance_exams/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /saved_questions/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /college_analytics_events/{eventId} {
      allow read: if isStaff();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /college_requests/{requestId} {
      allow read: if isStaff() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending_review';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Public duplicate index — only name/city keys, no submitter PII.
    match /college_request_duplicates/{duplicateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'nameLower', 'cityLower', 'requestId', 'createdAt'
        ]) &&
        request.resource.data.nameLower is string &&
        request.resource.data.cityLower is string &&
        request.resource.data.requestId is string &&
        request.resource.data.nameLower.size() > 0 &&
        request.resource.data.cityLower.size() > 0;
      allow update: if false;
      allow delete: if isAdmin() ||
        (
          isAuthenticated() &&
          exists(/databases/$(database)/documents/college_requests/$(resource.data.requestId)) &&
          get(/databases/$(database)/documents/college_requests/$(resource.data.requestId)).data.userId
            == request.auth.uid
        );
    }

    match /college_edit_suggestions/{suggestionId} {
      allow read: if isStaff() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        isVerifiedStudent() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /college_data_reports/{reportId} {
      allow read: if isStaff() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isStaff();
    }

    match /college_claims/{claimId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /college_accounts/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /college_official_content/{contentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (isAdmin() || isCollegeOfficial(request.resource.data.collegeId));
      allow update, delete: if isAdmin() ||
        (isAuthenticated() && isCollegeOfficial(resource.data.collegeId));
    }

    match /faculty_verification_requests/{requestId} {
      allow read: if isStaff() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /faculty_workshops/{workshopId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isVerifiedFaculty() &&
        request.resource.data.facultyId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isAuthenticated() && resource.data.facultyId == request.auth.uid);
    }

    match /faculty_research/{researchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isVerifiedFaculty() &&
        request.resource.data.facultyId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isAuthenticated() && resource.data.facultyId == request.auth.uid);
    }

    match /alumni_mentorship_offers/{offerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isVerifiedStudent() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationBadge == 'verified_alumni' &&
        request.resource.data.alumniId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isAuthenticated() && resource.data.alumniId == request.auth.uid);
    }

    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthenticated() &&
        request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /admin_settings/{docId} {
      // Public read so home can show banners/announcements.
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /super_admin_audit/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
